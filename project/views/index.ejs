<!DOCTYPE html>
<html lang="ru">
<head>
  <%- include("partials/head") %>
</head>
<body>
  <%- include("partials/header") %>
  <main class="container">
    <h1><%= heading %></h1>
    <% if (tours.length === 0) { %>
      <p class="empty">Туров пока нет. Зайдите позже!</p>
    <% } else { %>
      <p>Доступно туров: <%= tours.length %></p>
      <div class="cards">
        <% tours.forEach(function (tour) { %>
          <%- include("partials/card", { tour: tour }) %>
        <% }); %>
      </div>
    <% } %>
  </main>
  <%- include("partials/footer", { year: 2026 }) %>
</body>
</html>